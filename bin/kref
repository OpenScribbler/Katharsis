#!/usr/bin/env bash
# Runs the ledger reader, cli/kref.ts. Node 22.18 or later strips the types.
command -v node >/dev/null 2>&1 || { echo "kref: node not found; kref needs node 22.18 or later" >&2; exit 2; }
v="$(node --version 2>/dev/null)"
major="${v#v}"; major="${major%%.*}"
minor="${v#v*.}"; minor="${minor%%.*}"
case "$major.$minor" in
  *[!0-9.]*|.*|*.) echo "kref: can't read the node version from '$v'" >&2; exit 2 ;;
esac
if [ "$major" -lt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -lt 18 ]; }; then
  echo "kref: node $v is older than 22.18" >&2
  exit 2
fi
# Follow symlinks one hop at a time: readlink -f is missing on older macOS.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
exec node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON "$(dirname "$self")/../cli/kref.ts" "$@"
